# Copy to .env and customize. Never commit .env with real secrets.

# --- Local production-style (API on host, Postgres via docker compose) ---
NODE_ENV=production
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamtaskmanager?schema=public"
JWT_SECRET=generate-with-openssl-rand-base64-48-or-node-crypto
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
TRUST_PROXY=1
MAX_FILE_SIZE_MB=2

# --- When you have a live domain, set for example: ---
# CLIENT_URL=https://tasks.yourcompany.com
# ALLOWED_ORIGINS=https://tasks.yourcompany.com
# DATABASE_URL=postgresql://user:pass@host:5432/db?schema=public
