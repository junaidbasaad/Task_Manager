# Builds the web app when Railway service Root Directory is the repo root (monorepo fallback).
# Preferred: set Root Directory = frontend and use frontend/Dockerfile instead.
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci || npm install
COPY frontend/ .
RUN VITE_API_URL= npm run build

FROM nginx:1.27-alpine
RUN apk add --no-cache curl gettext
COPY frontend/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY frontend/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh
COPY --from=build /app/dist /usr/share/nginx/html
ENV PORT=80
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD sh -c 'curl -fsS "http://127.0.0.1:${PORT:-80}/" >/dev/null || exit 1'
ENTRYPOINT ["/docker-entrypoint.sh"]
