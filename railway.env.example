# Copy these into Railway service variables (Dashboard → Variables).
# Do NOT commit real secrets to GitHub.

# ========== API service (Root Directory: backend) ==========
NODE_ENV=production
PORT=4000
TRUST_PROXY=1
JWT_EXPIRES_IN=7d
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# From Railway Postgres plugin (Reference Variable → DATABASE_URL)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Your public frontend URL (no trailing slash)
CLIENT_URL=https://web-production-xxxx.up.railway.app
ALLOWED_ORIGINS=https://web-production-xxxx.up.railway.app

# ========== Web service (Root Directory: frontend) ==========
# Private network proxy to API (API service must be named "api")
API_UPSTREAM=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}

# Leave empty when nginx proxies /api on the same host (recommended)
VITE_API_URL=
